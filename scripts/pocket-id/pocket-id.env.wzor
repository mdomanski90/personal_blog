# P7a: ustawienia Pocket ID (wzór bez sekretów). Na serwerze: /etc/pocket-id/pocket-id.env (root:pocketid, 0640).
# Sekrety (ENCRYPTION_KEY, STATIC_API_KEY) dopisuje komenda instalacji – nigdy nie trafiają do repozytorium.
APP_URL=https://konto.odniepamieci.pl
HOST=127.0.0.1
PORT=1411
TRUST_PROXY=true
# strona nic nie wysyła na zewnątrz
ANALYTICS_DISABLED=true
# całość ustawień w tym pliku (nie w bazie): nazwa, e-mail nieobowiązkowy, bez samodzielnej rejestracji
UI_CONFIG_DISABLED=true
APP_NAME=odniepamieci.pl
REQUIRE_USER_EMAIL=false
ALLOW_USER_SIGNUPS=disabled
